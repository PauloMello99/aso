{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {},
    "clean:reset": {}
  },
  "globalEnv": [
    "PORT",
    "NODE_ENV",
    "RUN_MIGRATIONS",
    "DATABASE_URL",
    "DATABASE_APP_URL",
    "FRONTEND_URL",
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "CRON_SECRET",
    "NOTIFICATIONS_EMAIL_ENABLED",
    "RESEND_API_KEY",
    "NOTIFICATIONS_FROM_EMAIL",
    "NEXT_PUBLIC_API_URL"
  ]
}
