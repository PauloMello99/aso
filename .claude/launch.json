{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "frontend", "dev"],
      "port": 3000,
      "env": {
        "CI": "true"
      }
    },
    {
      "name": "backend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "backend", "dev"],
      "port": 3001,
      "env": {
        "CI": "true"
      }
    },
    {
      "name": "stripe-webhook",
      "runtimeExecutable": "stripe",
      "runtimeArgs": ["listen", "--forward-to", "localhost:3001/webhooks/stripe"],
      "port": 9900,
      "autoPort": false
    }
  ]
}
