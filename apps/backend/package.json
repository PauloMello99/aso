{
  "name": "backend",
  "version": "0.18.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "email:dev": "email dev --dir src/modules/mail/templates",
    "start": "node dist/main",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit -p tsconfig.build.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrator.ts up",
    "db:rollback": "tsx src/database/migrator.ts down",
    "db:status": "tsx src/database/migrator.ts status",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "clean": "pnpm -r exec rm -rf dist .turbo",
    "clean:reset": "pnpm clean && pnpm -r exec rm -rf node_modules"
  },
  "dependencies": {
    "@logtail/node": "^0.5.8",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.9",
    "@supabase/supabase-js": "^2.49.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.4",
    "rxjs": "^7.8.1",
    "stripe": "^22.3.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.3",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.1",
    "jest": "^30.4.2",
    "react-email": "^6.6.5",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "5.9.2"
  }
}
