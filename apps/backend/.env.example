# PostgreSQL — Supabase connection string
# Local (supabase start):  postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted (direct):         postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres?sslmode=require
# Hosted (pooler session): postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Supabase project credentials (para operações administrativas via SDK)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Migrações no boot do container. Em staging/production deixe "true" para o
# entrypoint rodar `migrator up` antes de subir o servidor. Local: deixe vazio
# e rode `pnpm db:migrate` manualmente.
RUN_MIGRATIONS=

# RLS-enforced runtime connection (NOBYPASSRLS) — normal request queries
DATABASE_APP_URL=

# Cron interno — segredo exigido em /internal/cron/* (header x-cron-secret).
# Em staging/prod, o workflow .github/workflows/cron.yml bate nesses endpoints
# com este segredo (secrets CRON_SECRET_STAGING / CRON_SECRET_PROD).
CRON_SECRET=
# E-mail transacional (Resend + React Email). Templates em
# src/modules/mail/templates; envio centralizado no MailService.
# Flag off OU sem RESEND_API_KEY → send() é no-op (retorna false; dev expõe os
# links no log/retorno). Com a flag ON, falha real de envio LANÇA: convite e
# reset de senha são críticos (abortam/revertem); notificações e welcome são
# best-effort. NOTIFICATIONS_FROM_EMAIL precisa usar um domínio VERIFICADO no
# Resend, senão o provedor recusa o envio.
NOTIFICATIONS_EMAIL_ENABLED=false
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=ASO <no-reply@assessorink-so.com>

# Allowlist de e-mail — trava de segurança pra não vazar e-mail de teste pra
# cliente real fora de produção (ResendEmailSender.send, checado ANTES de
# chamar o provedor; vale pra TODO e-mail do app, não só campanhas).
# Valores válidos (case-sensitive): production | staging | development | test.
# Valor DESCONHECIDO e não vazio (ex.: "Production", "producton") ABORTA o boot.
# APP_ENVIRONMENT ausente/vazio ou diferente de "production"
# ativa o enforcing — SEGURO por padrão, cobre local/dev automaticamente. Com
# enforcing ativo, EMAIL_ALLOWLIST vazia BLOQUEIA TODO envio (fail-safe
# deliberado, não é bug). Aceita múltiplos e-mails separados por
# vírgula/ponto-e-vírgula/espaço.
# ATENÇÃO — pré-requisito de deploy: setar APP_ENVIRONMENT=production em
# produção ANTES de subir esta trava, senão todo e-mail transacional
# (inclusive reset de senha e convite) para de sair.
APP_ENVIRONMENT=development
EMAIL_ALLOWLIST=

# E-mail de suporte exibido no rodapé dos templates (base-layout.tsx). Sem
# esta var, cai no fallback "suporte@assessorink-so.com".
SUPPORT_EMAIL=

# Kill-switch global das campanhas de e-mail por gatilho (T6 Bloco A — job
# interno "campaign-triggers"). Default "false": o job sai no primeiro gate sem
# tocar o banco. NÃO ligar antes do Bloco B: (1) a página pública de preferências
# /preferencias-email/<token> ainda não existe, então o link de descadastro dos
# e-mails é morto (LGPD); (2) o adapter de envio (ICampaignMailer) só é
# implementado na Fatia 4 e LANÇA até lá — com a flag ligada antes disso, todo
# alvo vira uma linha "failed" em campaign_sends e o dedupe_key é queimado, e
# esses clientes nunca recebem o e-mail quando o canal ficar pronto.
CAMPAIGNS_ENABLED=false

# Error tracking — Better Stack (Telemetry). Source da application "backend"
# (id 2554574). Sem AMBAS as vars → telemetria vira no-op (dev/local roda sem
# credenciais). Pegue token + ingesting host em: Better Stack → Sources →
# backend → Configure.
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGESTING_URL=https://<ingesting-host>.betterstackdata.com

# Billing (Stripe). Secret key da API (modo teste/produção conforme o
# ambiente); webhook secret usado para validar a assinatura do endpoint
# /webhooks/stripe via req.rawBody.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CAPTCHA (Cloudflare Turnstile) — usado no formulário público de abertura de
# ticket (módulo support). Sem esta var: verify() falha fechado (retorna
# false) a menos que TURNSTILE_DEV_BYPASS=true esteja setado explicitamente.
# Independente de NODE_ENV — o bypass NUNCA é implícito por ambiente.
TURNSTILE_SECRET_KEY=

# Bypass explícito do Turnstile quando TURNSTILE_SECRET_KEY não está setado.
# Só deve ser "true" em desenvolvimento local sem credencial real da
# Cloudflare. NUNCA setar "true" em staging/produção — sem secret e sem esta
# flag, verify() falha fechado (retorna false) em qualquer ambiente.
TURNSTILE_DEV_BYPASS=false

# Kill-switch da superfície pública de suporte (GET/POST /public/support/*,
# formulário de abertura de ticket sem autenticação). Default "false": os
# endpoints respondem 404 (não anuncia a rota) até setar explicitamente
# "true".
PUBLIC_SUPPORT_FORM_ENABLED=false

# E-mail-to-ticket (Resend Inbound). Endereco de recebimento montado como
# {SUPPORT_INBOUND_LOCAL_PART}+{ticketId}@{SUPPORT_INBOUND_DOMAIN} e usado como
# Reply-To nos e-mails de suporte enviados ao solicitante (threading por
# plus-addressing: a resposta do cliente volta com o ticketId no proprio "to").
# Sem SUPPORT_INBOUND_DOMAIN, o Reply-To e omitido e o fluxo de saida segue normal.
#
# NOTA DE INFRA (decisao de deploy, nao bloqueia desenvolvimento): o dominio
# escolhido e o RAIZ (assessorink-so.com), sem subdominio dedicado. A Resend recomenda
# subdominio dedicado (ex. suporte.assessorink-so.com) justamente para evitar conflito de
# registro MX: se assessorink-so.com ja tiver MX de e-mail corporativo (Google Workspace,
# Microsoft 365, etc.), adicionar o MX da Resend com menor prioridade no MESMO
# dominio pode desviar/duplicar a entrega do e-mail corporativo. Validar isso com
# quem administra o DNS ANTES de publicar o MX em producao; se houver conflito, a
# correcao e trocar SUPPORT_INBOUND_DOMAIN para um subdominio — mudanca de env,
# zero mudanca de codigo.
SUPPORT_INBOUND_DOMAIN=assessorink-so.com
SUPPORT_INBOUND_LOCAL_PART=suporte

# Segredo de assinatura do webhook "email.received" (Resend Inbound), gerado
# ao criar o webhook no dashboard da Resend (Webhooks → Add Webhook). Usado
# para verificar a assinatura Svix (headers webhook-id/timestamp/signature)
# em POST /webhooks/support-inbound (SupportInboundWebhookController).
# Diferente do TURNSTILE_SECRET_KEY: NÃO existe bypass de dev aqui — sem este
# valor, ResendInboundEmailClient.verifyWebhook SEMPRE lança, em qualquer
# NODE_ENV, porque um webhook não verificado autoriza escrita.
RESEND_WEBHOOK_SECRET=

# Segredo de assinatura do webhook de ENTREGA da Resend (bounce/delivered/
# etc.), usado para verificar a assinatura Svix (headers
# svix-id/svix-timestamp/svix-signature) em POST /webhooks/campaign-delivery.
# PRÓPRIO deste endpoint — diferente de RESEND_WEBHOOK_SECRET (webhook de
# inbound do support): reusar o mesmo segredo faria todo bounce dar 401,
# porque cada webhook configurado no dashboard da Resend tem seu próprio
# segredo. Assim como RESEND_WEBHOOK_SECRET, NÃO existe bypass de dev aqui —
# sem este valor, ResendCampaignDeliveryWebhookClient.verifyWebhook SEMPRE
# lança, em qualquer NODE_ENV, porque um webhook não verificado autoriza
# escrita (linha `bounced` + audit log).
# AÇÃO MANUAL (fora do alcance do código): o endpoint correspondente
# (Resend dashboard → Webhooks → Add Webhook → URL .../webhooks/campaign-delivery,
# evento email.bounced no mínimo) precisa ser criado manualmente no painel da
# Resend; o valor gerado lá é o que vai aqui.
RESEND_DELIVERY_WEBHOOK_SECRET=

# Kill-switch do e-mail de novidades do produto aos donos (job
# changelog-announcements no tick do cron). Default "false" (desligado): o job
# vira no-op. Só envia e-mail de release MAJOR/MINOR (ADR-0031). Requer também
# NOTIFICATIONS_EMAIL_ENABLED=true e RESEND_API_KEY. Fora de produção só envia
# para a EMAIL_ALLOWLIST (APP_ENVIRONMENT, ADR-0028). FRONTEND_URL é usado no CTA.
CHANGELOG_ANNOUNCEMENTS_ENABLED=false

# Kill-switch da superfície pública de billing (GET /public/billing/plans,
# preços vigentes consumidos pela landing page sem autenticação). Default
# "false": o endpoint responde 404 (não anuncia a rota) até setar
# explicitamente "true".
PUBLIC_PRICING_ENABLED=false

# Revalidação de cache ISR do frontend (POST {FRONTEND_URL}/api/revalidate),
# disparada best-effort pelo backend (webhook Stripe de produto/preço e job de
# reconciliação do catálogo) sempre que o catálogo de planos/preços muda.
# Reaproveita FRONTEND_URL (já definida acima). Segredo compartilhado com o
# frontend enviado no header x-revalidate-secret para autorizar a rota — NÃO É
# o mesmo segredo que CRON_SECRET (superfícies diferentes: CRON_SECRET nunca
# deve circular por uma rota exposta publicamente pelo frontend). Sem esta
# var, FrontendRevalidationClient vira no-op silencioso (loga warn, nunca
# lança) — a revalidação é sempre best-effort, uma falha aqui não pode
# derrubar o handler do webhook nem o job de cron.
REVALIDATE_SECRET=
