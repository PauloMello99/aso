# PostgreSQL — Supabase connection string
# Local (supabase start):  postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted (direct):         postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres?sslmode=require
# Hosted (pooler session): postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Supabase project credentials (para operações administrativas via SDK)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Migrações no boot do container. Em staging/production deixe "true" para o
# entrypoint rodar `migrator up` antes de subir o servidor. Local: deixe vazio
# e rode `pnpm db:migrate` manualmente.
RUN_MIGRATIONS=

# RLS-enforced runtime connection (NOBYPASSRLS) — normal request queries
DATABASE_APP_URL=

# Cron interno — segredo exigido em /internal/cron/* (header x-cron-secret).
# Em staging/prod, o workflow .github/workflows/cron.yml bate nesses endpoints
# com este segredo (secrets CRON_SECRET_STAGING / CRON_SECRET_PROD).
CRON_SECRET=
# E-mail transacional (Resend + React Email). Templates em
# src/modules/mail/templates; envio centralizado no MailService.
# Flag off OU sem RESEND_API_KEY → send() é no-op (retorna false; dev expõe os
# links no log/retorno). Com a flag ON, falha real de envio LANÇA: convite e
# reset de senha são críticos (abortam/revertem); notificações e welcome são
# best-effort. NOTIFICATIONS_FROM_EMAIL precisa usar um domínio VERIFICADO no
# Resend, senão o provedor recusa o envio.
NOTIFICATIONS_EMAIL_ENABLED=false
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=Studio Manager <no-reply@inkstudio-manager.com>

# E-mail de suporte exibido no rodapé dos templates (base-layout.tsx). Sem
# esta var, cai no fallback "suporte@inkops.app".
SUPPORT_EMAIL=

# Error tracking — Better Stack (Telemetry). Source da application "backend"
# (id 2554574). Sem AMBAS as vars → telemetria vira no-op (dev/local roda sem
# credenciais). Pegue token + ingesting host em: Better Stack → Sources →
# backend → Configure.
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGESTING_URL=https://<ingesting-host>.betterstackdata.com

# Billing (Stripe). Secret key da API (modo teste/produção conforme o
# ambiente); webhook secret usado para validar a assinatura do endpoint
# /webhooks/stripe via req.rawBody.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
