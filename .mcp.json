{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    },
    "supabase-local": {
      "type": "http",
      "url": "http://127.0.0.1:54321/mcp"
    },
    "postgres-local": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://postgres:postgres@localhost:54322/postgres"
      ]
    },
    "supabase-staging": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=qcnrfuqqvcsyhfzvlrch&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching%2Cstorage"
    },
    "postgres-staging": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://postgres.qcnrfuqqvcsyhfzvlrch:${SUPABASE_STAGING_DATABASE_PASSWORD}@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"
      ]
    },
    "supabase-production": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=xixfyjltofeaxobscqxi&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching%2Cstorage"
    },
    "postgres-production": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://postgres.xixfyjltofeaxobscqxi:${SUPABASE_PRODUCTION_DATABASE_PASSWORD}@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
      ]
    },
    "ink-memory": {
      "type": "stdio",
      "command": "wsl",
      "args": [
        "-e",
        "bash",
        "-lc",
        "exec ~/ink-ops-rag-venv/bin/python /mnt/c/Users/Paulo/Documents/Repos/Pessoal/aso/bin/scripts/rag/mcp_server.py"
      ]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PAT}"
      }
    },
    "railway": {
      "type": "http",
      "url": "https://mcp.railway.com"
    },
    "resend": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "resend-mcp"],
      "env": {
        "RESEND_API_KEY": "${RESEND_API_KEY}"
      }
    },
    "better-stack": {
      "type": "http",
      "url": "https://mcp.betterstack.com",
      "headers": {
        "Authorization": "Bearer ${BETTERSTACK_TOKEN}"
      }
    },
    "stripe-staging": {
      "url": "https://mcp.stripe.com",
      "headers": {
        "Authorization": "Bearer ${STRIPE_RESTRICT_KEY}",
        "Stripe-Account": "acct_1TsJDx0NG0bf6v4A"
      }
    },
    "stripe-production": {
      "url": "https://mcp.stripe.com",
      "headers": {
        "Authorization": "Bearer ${STRIPE_RESTRICT_PRODUCTION_KEY}",
        "Stripe-Account": "acct_1TsJDx0NG0bf6v4A"
      }
    }
  }
}
