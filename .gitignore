# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Prevent compiled files in source
packages/*/src/*.js
packages/*/src/*.d.ts
packages/*/src/*.js.map
packages/*/src/*.ts.map

# RAG / Memory
# docker-compose.rag.yml is versioned (shared Qdrant container, ADR-0015).
.rag/
.memory/sessions/

# Agentic workflow scratch (ledger, handoffs) - transient, per-session
.claude/scratch/

# Python
**/__pycache__/
**/.venv/

# Arquivos de acesso a bancos (credenciais em texto plano) — nunca versionar
inkhouse-access.md
aso-access.md

# Migração Ink House → ASO: contém connection string de prod + PII de clientes reais.
# Roteiro/decisões ficam no doc de levantamento; os artefatos não são versionados.
scripts/inkhouse-migration/